pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    environment {
        DEPLOY_DIR = '/home/ubuntu/deploy/S14P31A401'
        COMPOSE_FILE = 'compose.yaml'
        PROJECT_NAME = 'marketing'
    }

    stages {
        stage('Checkout Info') {
            steps {
                sh '''
                    echo "===== Current Directory ====="
                    pwd

                    echo "===== Workspace Files ====="
                    ls -al

                    echo "===== Git Branch ====="
                    git branch -a || true
                '''
            }
        }

        stage('Detect Changed Services') {
            steps {
                sh '''
                    set -eu

                    echo "===== Detect changed services ====="

                    BUILD_SERVICES_FILE=".build-services"
                    BASE_COMMIT="${GIT_PREVIOUS_COMMIT:-${GIT_PREVIOUS_SUCCESSFUL_COMMIT:-}}"

                    append_service() {
                      services="$1"
                      service="$2"

                      echo "$services" | grep -Eq "(^| )${service}( |$)" && {
                        echo "$services"
                        return
                      }

                      echo "$services $service" | xargs
                    }

                    if [ -z "$BASE_COMMIT" ] || ! git cat-file -e "$BASE_COMMIT^{commit}" 2>/dev/null; then
                      echo "No valid previous commit. Build all application images."
                      echo "spring frontend nginx fastapi" > "$BUILD_SERVICES_FILE"
                      exit 0
                    fi

                    TARGET_COMMIT="${GIT_COMMIT:-HEAD}"
                    CHANGED_FILES="$(git diff --name-only "$BASE_COMMIT" "$TARGET_COMMIT")"

                    echo "Base commit: $BASE_COMMIT"
                    echo "Target commit: $TARGET_COMMIT"
                    echo "Changed files:"
                    printf '%s\\n' "$CHANGED_FILES"

                    SERVICES=""

                    # Compose/Jenkins 변경은 서비스 의존 관계나 배포 방식 자체가 바뀔 수 있어 전체 이미지를 다시 빌드한다.
                    if printf '%s\\n' "$CHANGED_FILES" | grep -Eq '^(compose\\.yaml|common/Jenkinsfile)$'; then
                      SERVICES="spring frontend nginx fastapi"
                    else
                      printf '%s\\n' "$CHANGED_FILES" | grep -Eq '^be/' && SERVICES="$(append_service "$SERVICES" spring)"
                      printf '%s\\n' "$CHANGED_FILES" | grep -Eq '^fe/' && SERVICES="$(append_service "$SERVICES" frontend)"
                      printf '%s\\n' "$CHANGED_FILES" | grep -Eq '^nginx/' && SERVICES="$(append_service "$SERVICES" nginx)"
                      printf '%s\\n' "$CHANGED_FILES" | grep -Eq '^ai/' && SERVICES="$(append_service "$SERVICES" fastapi)"
                    fi

                    echo "$SERVICES" | xargs > "$BUILD_SERVICES_FILE"
                    echo "Services selected for image build: $(cat "$BUILD_SERVICES_FILE")"
                '''
            }
        }

        stage('Prepare Deploy Directory') {
            steps {
                sh '''
                    echo "===== Prepare deploy directory ====="
                    mkdir -p "${DEPLOY_DIR}"

                    echo "===== Clean deploy directory ====="
                    rm -rf "${DEPLOY_DIR:?}/"* "${DEPLOY_DIR}"/.[!.]* "${DEPLOY_DIR}"/..?* 2>/dev/null || true

                    echo "===== Copy GitLab workspace to deploy directory ====="
                    tar \
                      --exclude='./.git' \
                      --exclude='*/node_modules' \
                      --exclude='*/dist' \
                      --exclude='*/build' \
                      --exclude='*/.gradle' \
                      --exclude='*/.pnpm-store' \
                      --exclude='./.env' \
                      --exclude='./secrets' \
                      --exclude='./be/src/main/resources/firebase/firebase-service-account.json' \
                      -cf - . | tar -C "${DEPLOY_DIR}" -xf -

                    echo "===== Deploy directory files ====="
                    ls -al "${DEPLOY_DIR}"
                '''
            }
        }

        stage('Prepare Env') {
            steps {
                withCredentials([file(credentialsId: 'marketing-env-file', variable: 'ENV_FILE_PATH')]) {
                    sh '''
                        set +x

                        echo "===== Create .env from Jenkins Secret File ====="

                        cp "$ENV_FILE_PATH" "${DEPLOY_DIR}/.env"
                        sed -i 's/\\r$//' "${DEPLOY_DIR}/.env"
                        chmod 600 "${DEPLOY_DIR}/.env"

                        echo ".env created at ${DEPLOY_DIR}/.env"
                    '''
                }
            }
        }

        stage('Prepare Firebase Secret') {
            steps {
                withCredentials([file(credentialsId: 'marketing-firebase-service-account-file', variable: 'FIREBASE_SERVICE_ACCOUNT_FILE')]) {
                    sh '''
                        set +x
                        set -eu

                        echo "===== Create Firebase service account secret ====="

                        mkdir -p "${DEPLOY_DIR}/secrets"
                        cp "$FIREBASE_SERVICE_ACCOUNT_FILE" "${DEPLOY_DIR}/secrets/firebase-service-account.json"
                        chmod 600 "${DEPLOY_DIR}/secrets/firebase-service-account.json"

                        test -s "${DEPLOY_DIR}/secrets/firebase-service-account.json"
                        grep -q '"type"[[:space:]]*:[[:space:]]*"service_account"' "${DEPLOY_DIR}/secrets/firebase-service-account.json"

                        echo "Firebase service account secret file created."
                    '''
                }
            }
        }

        stage('Validate Env') {
            steps {
                sh '''
                    set +x
                    set -eu

                    echo "===== Validate required env values ====="

                    ENV_PATH="${DEPLOY_DIR}/.env"
                    test -s "$ENV_PATH"

                    echo "===== .env keys only ====="
                    awk -F= \'
                      /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/ {
                        key=$1
                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
                        print "line " NR ": " key
                      }
                    ' "$ENV_PATH"

                    # CRLF 방지
                    if grep -q "$(printf '\\r')" "$ENV_PATH"; then
                      echo "ERROR: .env contains CRLF. Use LF line endings."
                      exit 1
                    fi

                    # 중복 key 방지
                    DUP_KEYS=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_PATH" | cut -d= -f1 | sort | uniq -d || true)
                    if [ -n "$DUP_KEYS" ]; then
                      echo "ERROR: duplicated env keys:"
                      echo "$DUP_KEYS"
                      exit 1
                    fi

                    get_env() {
                      key="$1"
                      grep -E "^${key}=" "$ENV_PATH" | tail -n 1 | cut -d= -f2-
                    }

                    require_env() {
                      key="$1"
                      value="$(get_env "$key" || true)"

                      if [ -z "$value" ]; then
                        echo "ERROR: missing or empty env: $key"
                        exit 1
                      fi

                      case "$value" in
                        "changeme"|"CHANGE_ME"|"your_domain"|"your-bucket-name"|"TODO"|"todo"|"null"|"undefined")
                          echo "ERROR: placeholder value is not allowed for $key"
                          exit 1
                          ;;
                      esac
                    }

                    require_optional_integer() {
                      key="$1"
                      value="$(get_env "$key" || true)"

                      if [ -z "$value" ]; then
                        return
                      fi

                      echo "$value" | grep -Eq '^-?[0-9]+$' || {
                        echo "ERROR: ${key} should be an integer"
                        exit 1
                      }
                    }

                    require_optional_positive_integer() {
                      key="$1"
                      value="$(get_env "$key" || true)"

                      if [ -z "$value" ]; then
                        return
                      fi

                      echo "$value" | grep -Eq '^[1-9][0-9]*$' || {
                        echo "ERROR: ${key} should be a positive integer"
                        exit 1
                      }
                    }

                    require_env POSTGRES_DB
                    require_env POSTGRES_USER
                    require_env POSTGRES_PASSWORD
                    require_env REDIS_PASSWORD

                    require_env S3_BUCKET_NAME
                    require_env S3_REGION
                    require_env S3_ACCESS_KEY
                    require_env S3_SECRET_KEY
                    require_env CLOUDFRONT_DOMAIN

                    require_env VITE_KAKAO_MAP_KEY
                    require_env VITE_FIREBASE_API_KEY
                    require_env VITE_FIREBASE_AUTH_DOMAIN
                    require_env VITE_FIREBASE_PROJECT_ID
                    require_env VITE_FIREBASE_STORAGE_BUCKET
                    require_env VITE_FIREBASE_MESSAGING_SENDER_ID
                    require_env VITE_FIREBASE_MEASUREMENT_ID
                    require_env VITE_FIREBASE_APP_ID
                    require_env VITE_FIREBASE_VAPID_KEY
                    require_env VITE_API_BACKEND_URL

                    require_env JWT_SECRET
                    require_env OAUTH_REDIRECT_URI
                    require_env FRONTEND_URL
                    require_env INSTAGRAM_CLIENT_ID
                    require_env INSTAGRAM_CLIENT_SECRET
                    require_env FIREBASE_ENABLED
                    require_optional_positive_integer KEYWORD_MODEL_SERVER_PORT
                    require_optional_positive_integer KEYWORD_MODEL_CTX_SIZE
                    require_optional_integer KEYWORD_MODEL_GPU_LAYERS
                    require_optional_positive_integer CAPTION_MODEL_SERVER_PORT
                    require_optional_positive_integer CAPTION_MODEL_CTX_SIZE
                    require_optional_integer CAPTION_MODEL_GPU_LAYERS

                    # region 형식 간단 검증
                    S3_REGION_VALUE="$(get_env S3_REGION)"
                    echo "$S3_REGION_VALUE" | grep -Eq '^[a-z]{2}-[a-z]+-[0-9]+$' || {
                      echo "ERROR: invalid S3_REGION format"
                      exit 1
                    }

                    # CloudFront domain 형식 간단 검증
                    CLOUDFRONT_DOMAIN_VALUE="$(get_env CLOUDFRONT_DOMAIN)"
                    echo "$CLOUDFRONT_DOMAIN_VALUE" | grep -Eq '^https?://' && {
                      echo "ERROR: CLOUDFRONT_DOMAIN should not include http:// or https://"
                      echo "Example: dxxxxx.cloudfront.net"
                      exit 1
                    }

                    echo "$CLOUDFRONT_DOMAIN_VALUE" | grep -Eq '^[A-Za-z0-9.-]+$' || {
                      echo "ERROR: invalid CLOUDFRONT_DOMAIN format"
                      exit 1
                    }

                    FIREBASE_ENABLED_VALUE="$(get_env FIREBASE_ENABLED)"
                    echo "$FIREBASE_ENABLED_VALUE" | grep -Eq '^(true|false)$' || {
                      echo "ERROR: FIREBASE_ENABLED should be true or false"
                      exit 1
                    }

                    if [ "$FIREBASE_ENABLED_VALUE" != "true" ]; then
                      echo "ERROR: FIREBASE_ENABLED must be true for this deployment"
                      exit 1
                    fi

                    echo ".env validation passed"
                '''
            }
        }

        stage('Check Required Files') {
            steps {
                sh '''
                    echo "===== Check required files ====="

                    test -f "${DEPLOY_DIR}/compose.yaml"
                    test -f "${DEPLOY_DIR}/common/Jenkinsfile"
                    test -f "${DEPLOY_DIR}/nginx/conf.d/default.conf"

                    test -f "${DEPLOY_DIR}/be/Dockerfile"
                    test -f "${DEPLOY_DIR}/fe/Dockerfile"
                    test -f "${DEPLOY_DIR}/ai/Dockerfile"
                    test -f "${DEPLOY_DIR}/secrets/firebase-service-account.json"
                    test -s "${DEPLOY_DIR}/secrets/firebase-service-account.json"
                    test ! -d "${DEPLOY_DIR}/secrets/firebase-service-account.json"

                    echo "All required files exist."
                '''
            }
        }

        stage('Provision Llama Models') {
            steps {
              withCredentials([string(credentialsId: 'HF_TOKEN', variable: 'HF_TOKEN')]) {
                sh '''
                    set +x
                    set -eu

                    echo "===== Provision llama models ====="

                    ENV_PATH="${DEPLOY_DIR}/.env"

                    get_env() {
                      key="$1"
                      grep -E "^${key}=" "$ENV_PATH" | tail -n 1 | cut -d= -f2- || true
                    }

                    provision_model() {
                      model_role="$1"

                      case "$model_role" in
                        KEYWORD)
                          MODEL_LABEL="keyword-model"
                          DEFAULT_MODEL_HOST_DIR="/home/ubuntu/marketing/models/keyword/exaone-3.5-7.8b-instruct/q4_k_m"
                          DEFAULT_MODEL_HF_REPO_ID="LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct-GGUF"
                          DEFAULT_MODEL_HF_FILENAME="EXAONE-3.5-7.8B-Instruct-Q4_K_M.gguf"
                          MODEL_CONTAINER_DIR="/models/exaone-3.5-7.8b-instruct/q4_k_m"
                          ;;
                        CAPTION)
                          MODEL_LABEL="caption-model"
                          DEFAULT_MODEL_HOST_DIR="/home/ubuntu/marketing/models/caption/exaone-4.0-32b/q4_k_m"
                          DEFAULT_MODEL_HF_REPO_ID="LGAI-EXAONE/EXAONE-4.0-32B-GGUF"
                          DEFAULT_MODEL_HF_FILENAME="EXAONE-4.0-32B-Q4_K_M.gguf"
                          MODEL_CONTAINER_DIR="/models/exaone-4.0-32b/q4_k_m"
                          ;;
                        *)
                          echo "ERROR: unsupported model role: $model_role"
                          exit 1
                          ;;
                      esac

                      MODEL_FILENAME="model.gguf"
                      MODEL_CONTAINER_PATH="${MODEL_CONTAINER_DIR}/${MODEL_FILENAME}"
                      MODEL_HOST_DIR_RAW="$(get_env ${model_role}_MODEL_HOST_DIR)"
                      MODEL_HF_REPO_ID_VALUE="$(get_env ${model_role}_MODEL_HF_REPO_ID)"
                      MODEL_HF_FILENAME_VALUE="$(get_env ${model_role}_MODEL_HF_FILENAME)"

                      if [ -z "$MODEL_HOST_DIR_RAW" ]; then
                        MODEL_HOST_DIR_RAW="$DEFAULT_MODEL_HOST_DIR"
                      fi

                      if [ -z "$MODEL_HF_REPO_ID_VALUE" ]; then
                        MODEL_HF_REPO_ID_VALUE="$DEFAULT_MODEL_HF_REPO_ID"
                      fi

                      if [ -z "$MODEL_HF_FILENAME_VALUE" ]; then
                        MODEL_HF_FILENAME_VALUE="$DEFAULT_MODEL_HF_FILENAME"
                      fi

                      case "$MODEL_HOST_DIR_RAW" in
                        /*)
                          MODEL_HOST_DIR_VALUE="$MODEL_HOST_DIR_RAW"
                          ;;
                        *)
                          MODEL_HOST_DIR_VALUE="${DEPLOY_DIR}/${MODEL_HOST_DIR_RAW#./}"
                          ;;
                      esac

                      mkdir -p "$MODEL_HOST_DIR_VALUE"
                      MODEL_HOST_DIR_VALUE="$(cd "$MODEL_HOST_DIR_VALUE" && pwd -P)"
                      MODEL_PATH="${MODEL_HOST_DIR_VALUE}/${MODEL_FILENAME}"

                      print_step_status() {
                        label="$1"
                        status="$2"
                        echo "[${MODEL_LABEL}] ${label}: ${status}"
                      }

                      run_observation() {
                        label="$1"
                        shift
                        echo "[${MODEL_LABEL}] observe: ${label}"
                        "$@"
                        rc=$?
                        echo "[${MODEL_LABEL}] observe exit=${rc}: ${label}"
                        return 0
                      }

                      collect_model_diagnostics() {
                        set +e
                        echo "===== ${MODEL_LABEL} diagnostics ====="
                        echo "Current user: $(id -un)"
                        echo "Current uid/gid: $(id -u):$(id -g)"
                        echo "Current working directory: $(pwd)"
                        echo "Resolved host dir: $MODEL_HOST_DIR_VALUE"
                        echo "Resolved model path: $MODEL_PATH"
                        echo "Resolved container dir: $MODEL_CONTAINER_DIR"
                        echo "Resolved container path: $MODEL_CONTAINER_PATH"
                        run_observation "host dir listing" ls -lah "$MODEL_HOST_DIR_VALUE"
                        run_observation "host model stat" stat "$MODEL_PATH"
                        run_observation "host model type" file "$MODEL_PATH"
                        run_observation "host model size" du -h "$MODEL_PATH"
                        run_observation "path permissions" namei -l "$MODEL_PATH"
                        run_observation "jenkins user readability" test -r "$MODEL_PATH"
                        run_observation "jenkins user file existence" test -f "$MODEL_PATH"
                        run_observation "container mount listing" docker run --rm -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" python:3.12-slim ls -lah "$MODEL_CONTAINER_DIR"
                        run_observation "container mount model existence" docker run --rm -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" python:3.12-slim python -c "from pathlib import Path; p=Path('$MODEL_CONTAINER_PATH'); print(p.exists(), p.stat().st_size if p.exists() else 'missing')"
                        if command -v sudo >/dev/null 2>&1 && id jenkins >/dev/null 2>&1; then
                          run_observation "sudo -u jenkins file existence" sudo -n -u jenkins test -f "$MODEL_PATH"
                        fi
                        set -e
                      }

                      require_check() {
                        label="$1"
                        shift
                        if "$@"; then
                          print_step_status "$label" "ok"
                          return 0
                        fi

                        rc=$?
                        print_step_status "$label" "failed (exit=${rc})"
                        collect_model_diagnostics
                        exit "$rc"
                      }

                      note_observation_limitations() {
                        echo "[${MODEL_LABEL}] note: Jenkins host-side file checks may differ from the Docker daemon view."
                        echo "[${MODEL_LABEL}] note: Docker mount revalidation is the deployment gate for this stage."
                      }

                      echo "${MODEL_LABEL} host dir: $MODEL_HOST_DIR_VALUE"
                      echo "${MODEL_LABEL} container dir: $MODEL_CONTAINER_DIR"
                      echo "${MODEL_LABEL} source: ${MODEL_HF_REPO_ID_VALUE}/${MODEL_HF_FILENAME_VALUE}"
                      echo "${MODEL_LABEL} file path: $MODEL_PATH"
                      note_observation_limitations

                      if [ ! -f "$MODEL_PATH" ]; then
                        echo "${MODEL_LABEL} is missing. Downloading the GGUF artifact..."
                        if [ -n "${HF_TOKEN:-}" ]; then
                          echo "${MODEL_LABEL} will download from the HF Hub with authentication."
                          HF_TOKEN_DOCKER_ARG="-e HF_TOKEN=$HF_TOKEN"
                        else
                          echo "${MODEL_LABEL} will download from the HF Hub without authentication."
                          HF_TOKEN_DOCKER_ARG=""
                        fi

                        docker_run_rc=0
                        docker run --rm \
                          -e HF_HOME=/tmp/hf-home \
                          ${HF_TOKEN_DOCKER_ARG} \
                          -e MODEL_HF_REPO_ID="$MODEL_HF_REPO_ID_VALUE" \
                          -e MODEL_HF_FILENAME="$MODEL_HF_FILENAME_VALUE" \
                          -e TARGET_PATH="$MODEL_CONTAINER_PATH" \
                          -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" \
                          python:3.12-slim sh -ceu '
                            python -m pip install --disable-pip-version-check --no-cache-dir huggingface_hub >/tmp/pip-install.log
                            python - <<'"'"'PY'"'"'
import os
import shutil
from pathlib import Path

from huggingface_hub import hf_hub_download

repo_id = os.environ["MODEL_HF_REPO_ID"]
filename = os.environ["MODEL_HF_FILENAME"]
target_path = Path(os.environ["TARGET_PATH"])
temp_path = target_path.with_suffix(".download")

try:
    downloaded_path = Path(
        hf_hub_download(
            repo_id=repo_id,
            filename=filename,
            repo_type="model",
        )
    )
    target_path.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(downloaded_path, temp_path)
    temp_path.replace(target_path)
    print(f"Downloaded {repo_id}/{filename} -> {target_path}")
except Exception as exc:
    temp_path.unlink(missing_ok=True)
    raise SystemExit(
        f"Failed to download model {repo_id}/{filename} to {target_path}: {exc}"
    ) from exc
PY
                            ls -lah '"$MODEL_CONTAINER_DIR"'
                          ' || docker_run_rc=$?

                        echo "docker_run_exit=${docker_run_rc}"
                        if [ "$docker_run_rc" -ne 0 ]; then
                          print_step_status "docker download container" "failed"
                          collect_model_diagnostics
                          exit "$docker_run_rc"
                        fi

                        print_step_status "docker download container" "ok"
                      else
                        echo "${MODEL_LABEL} already exists. Skip download."
                      fi

                      require_check "docker mount directory exists" docker run --rm -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" python:3.12-slim test -d "$MODEL_CONTAINER_DIR"
                      require_check "docker mount model file exists" docker run --rm -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" python:3.12-slim test -f "$MODEL_CONTAINER_PATH"
                      require_check "docker mount model file is readable" docker run --rm -v "$MODEL_HOST_DIR_VALUE:$MODEL_CONTAINER_DIR" python:3.12-slim python -c "from pathlib import Path; p=Path('$MODEL_CONTAINER_PATH'); print(p.stat().st_size); assert p.stat().st_size > 0"
                    }

                    provision_model KEYWORD
                    provision_model CAPTION
                '''
            }
        }
        }
        stage('Check Docker') {
            steps {
                sh '''
                    echo "===== Docker Version ====="
                    docker version

                    echo "===== Docker Compose Version ====="
                    docker compose version
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                dir("${DEPLOY_DIR}") {
                    sh '''
                        echo "===== Validate compose.yaml ====="
                        # docker compose config는 env 값을 펼쳐 출력할 수 있으므로 검증 결과만 남긴다.
                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env config >/dev/null
                        echo "Compose config validation passed"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${DEPLOY_DIR}") {
                    sh '''
                        set -eu

                        echo "===== Build changed services and deploy ====="

                        BUILD_SERVICES="$(cat .build-services 2>/dev/null || true)"
                        export BUILD_COMMIT="${GIT_COMMIT:-unknown}"

                        append_service() {
                          services="$1"
                          service="$2"

                          echo "$services" | grep -Eq "(^| )${service}( |$)" && {
                            echo "$services"
                            return
                          }

                          echo "$services $service" | xargs
                        }

                        # 서버에 이미지가 없는 첫 배포/정리 직후에는 Git 변경 여부와 무관하게 필요한 이미지를 빌드한다.
                        docker image inspect marketing-spring:latest >/dev/null 2>&1 || BUILD_SERVICES="$(append_service "$BUILD_SERVICES" spring)"
                        docker image inspect marketing-frontend:latest >/dev/null 2>&1 || BUILD_SERVICES="$(append_service "$BUILD_SERVICES" frontend)"
                        docker image inspect marketing-fastapi:latest >/dev/null 2>&1 || BUILD_SERVICES="$(append_service "$BUILD_SERVICES" fastapi)"
                        docker image inspect "${PROJECT_NAME}-nginx" >/dev/null 2>&1 || BUILD_SERVICES="$(append_service "$BUILD_SERVICES" nginx)"

                        # Start shared dependencies before application container recreation.
                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env up -d postgres redis keyword-server caption-server

                        echo "Build commit: $BUILD_COMMIT"
                        echo "Build services: ${BUILD_SERVICES:-none}"

                        if [ -n "$BUILD_SERVICES" ]; then
                          # 변경된 도메인의 이미지만 다시 빌드한다. BUILD_COMMIT은 이미지 라벨로 남아 배포 커밋 추적에 사용된다.
                          docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env build $BUILD_SERVICES

                          # 애플리케이션 컨테이너 교체 전에 공용 인프라 컨테이너를 먼저 보장한다.
                          docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env up -d postgres redis keyword-server caption-server

                          # 변경된 서비스만 새 이미지로 교체한다. DB/Redis 같은 의존 서비스는 불필요하게 재시작하지 않는다.
                          docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env up -d --no-deps --force-recreate $BUILD_SERVICES
                        else
                          echo "No application image changes detected. Skip image build."
                        fi

                        # compose.yaml 기준으로 누락/삭제된 컨테이너 상태를 정리한다.
                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env up -d --remove-orphans

                        echo "===== Running containers ====="
                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env ps

                        echo "===== Deployed image revisions ====="
                        docker inspect project-spring --format 'spring={{ index .Config.Labels "org.opencontainers.image.revision" }}' || true
                        docker inspect project-frontend --format 'frontend={{ index .Config.Labels "org.opencontainers.image.revision" }}' || true
                        docker inspect project-nginx --format 'nginx={{ index .Config.Labels "org.opencontainers.image.revision" }}' || true
                        docker inspect project-fastapi --format 'fastapi={{ index .Config.Labels "org.opencontainers.image.revision" }}' || true
                        docker inspect project-keyword-server --format 'keyword-server={{ .Config.Image }}' || true
                        docker inspect project-caption-server --format 'caption-server={{ .Config.Image }}' || true
                    '''
                }
            }
        }
//        stage('Deploy') {
//            steps {
//                dir("${DEPLOY_DIR}") {
//                    sh '''
//                        echo "===== Build and start containers ====="
//                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env up -d --build --remove-orphans
//
//                        echo "===== Running containers ====="
//                        docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env ps
//                    '''
//                }
//            }
//        }

        stage('Check Nginx Config') {
            steps {
                dir("${DEPLOY_DIR}") {
                    sh '''
                        echo "===== Nginx config test ====="
                        docker exec project-nginx nginx -t
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                dir("${DEPLOY_DIR}") {
                    sh '''
                        NETWORK="${PROJECT_NAME}_project-network"
                        ENV_PATH=".env"

                        get_env() {
                            key="$1"
                            grep -E "^${key}=" "$ENV_PATH" | tail -n 1 | cut -d= -f2- || true
                        }

                        KEYWORD_SERVER_PORT="$(get_env KEYWORD_MODEL_SERVER_PORT)"
                        CAPTION_SERVER_PORT="$(get_env CAPTION_MODEL_SERVER_PORT)"

                        if [ -z "$KEYWORD_SERVER_PORT" ]; then
                            KEYWORD_SERVER_PORT="8001"
                        fi

                        if [ -z "$CAPTION_SERVER_PORT" ]; then
                            CAPTION_SERVER_PORT="8002"
                        fi

                        echo "Using network: $NETWORK"

                        echo "===== Waiting for nginx/frontend ====="
                        for i in $(seq 1 30); do
                            if docker run --rm --network "$NETWORK" curlimages/curl:latest -fsS http://nginx > /dev/null; then
                                echo "nginx/frontend is ready"
                                break
                            fi

                            echo "nginx/frontend not ready yet... retry $i/30"
                            sleep 2

                            if [ "$i" -eq 30 ]; then
                                echo "nginx/frontend health check failed"
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs nginx --tail=100
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs frontend --tail=100
                                exit 1
                            fi
                        done

                        echo "===== Checking Spring API ====="
                        for i in $(seq 1 30); do
                            if docker run --rm --network "$NETWORK" curlimages/curl:latest -fsS http://nginx/api/health; then
                                echo "spring api is ready"
                                break
                            fi

                            echo "spring api not ready yet... retry $i/30"
                            sleep 2

                            if [ "$i" -eq 30 ]; then
                                echo "spring health check failed"
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs spring --tail=100
                                exit 1
                            fi
                        done

                        # Check the real AI containers directly instead of Spring's static ai-health endpoint.
                        echo "===== Checking FastAPI Health ====="
                        for i in $(seq 1 30); do
                            if docker run --rm --network "$NETWORK" curlimages/curl:latest -fsS http://fastapi:8000/ai/health; then
                                echo "fastapi is ready"
                                break
                            fi

                            echo "fastapi health not ready yet... retry $i/30"
                            sleep 2

                            if [ "$i" -eq 30 ]; then
                                echo "fastapi health check failed"
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs fastapi --tail=100
                                exit 1
                            fi
                        done

                        echo "===== Checking Keyword Server Health ====="
                        for i in $(seq 1 30); do
                            if docker run --rm --network "$NETWORK" curlimages/curl:latest -fsS "http://keyword-server:${KEYWORD_SERVER_PORT}/health"; then
                                echo "keyword-server is ready"
                                break
                            fi

                            echo "keyword-server health not ready yet... retry $i/30"
                            sleep 2

                            if [ "$i" -eq 30 ]; then
                                echo "keyword-server health check failed"
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs keyword-server --tail=100
                                exit 1
                            fi
                        done

                        echo "===== Checking Caption Server Health ====="
                        for i in $(seq 1 30); do
                            if docker run --rm --network "$NETWORK" curlimages/curl:latest -fsS "http://caption-server:${CAPTION_SERVER_PORT}/health"; then
                                echo "caption-server is ready"
                                break
                            fi

                            echo "caption-server health not ready yet... retry $i/30"
                            sleep 2

                            if [ "$i" -eq 30 ]; then
                                echo "caption-server health check failed"
                                docker compose -p "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file .env logs caption-server --tail=100
                                exit 1
                            fi
                        done
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Deploy success.'
        }

        failure {
            echo 'Deploy failed. Check console output.'
        }
    }
}
